NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Local PostgreSQL from compose.yaml
DATABASE_URL=postgres://hashie:hashie@localhost:5433/hashie

# Clerk server values. Keep these empty for health-only local work.
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://localhost:8081
CLERK_WEBHOOK_SIGNING_SECRET=

REQUEST_BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
RETENTION_DAYS=30

# Provider access belongs on the server only. The gateway contract is not yet
# production-approved for Clerk identity or Akan/Twi traffic.
HASHIE_GATEWAY_URL=https://hashie-llm-openai-gateway-5bq6okiwgq-ew.a.run.app/v1
HASHIE_GATEWAY_TOKEN=
HASHIE_GATEWAY_ENABLED=false
HASHIE_GATEWAY_TIMEOUT_MS=15000
HASHIE_GATEWAY_MAX_RETRIES=2
HASHIE_AKAN_TIMEOUT_MS=30000
