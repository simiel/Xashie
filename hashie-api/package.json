{
  "name": "hashie-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:run": "node dist/src/db/migrate.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:local:start": "sh ./scripts/local-postgres.sh start",
    "db:local:stop": "sh ./scripts/local-postgres.sh stop",
    "db:local:status": "sh ./scripts/local-postgres.sh status"
  },
  "dependencies": {
    "@clerk/backend": "^2.20.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@sinclair/typebox": "^0.34.41",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.5.0",
    "fastify-plugin": "^5.0.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.5",
    "eslint": "^9.39.5",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.1.11"
  }
}
