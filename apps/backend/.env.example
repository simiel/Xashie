NODE_ENV=development
PORT=3000

# Required for real Clerk verification. Keep secrets server-side.
CLERK_SECRET_KEY=sk_test_replace_with_clerk_secret
CLERK_JWT_KEY=replace_with_clerk_jwt_key_if_used
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_clerk_publishable_key
CLERK_AUTHORIZED_PARTIES=http://localhost:8081,http://localhost:19006

# Required for the real server-only Supabase adapter.
SUPABASE_URL=https://replace-with-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key

# Explicit local-only opt-in. Never enable this in production.
HASHIE_DATA_STORE=unavailable
HASHIE_ALLOW_INSECURE_MEMORY_STORE=false
