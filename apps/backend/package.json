{
  "name": "@hashie/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hashie server-owned API boundary for guest sessions, Clerk actors, and onboarding preferences.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node --enable-source-maps dist/src/server.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "start": "node --enable-source-maps dist/src/server.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "ingest:knowledge": "npm run build && node --env-file=.env.local scripts/ingest-health-knowledge.mjs",
    "smoke:gateway-languages": "npm run build && node --env-file=.env.local scripts/smoke-gateway-languages.mjs",
    "smoke:agent-stream": "npm run build && node --env-file=.env.local scripts/smoke-agent-stream.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.49",
    "@clerk/backend": "3.16.10",
    "ai": "^7.0.102"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "typescript": "6.0.3"
  }
}
