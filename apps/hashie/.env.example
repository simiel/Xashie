# Client-safe Expo values only. EXPO_PUBLIC_* values are bundled into the app.
# The current prototype does not yet read these values; keep these names for the
# upcoming client-to-backend and Clerk wiring.
EXPO_PUBLIC_HASHIE_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_clerk_publishable_key

# Google OAuth is configured in the Clerk Dashboard, not in this file or source.
# Never add CLERK_SECRET_KEY, CLERK_JWT_KEY, SUPABASE_SERVICE_ROLE_KEY,
# database credentials, or other server secrets to the mobile environment.
