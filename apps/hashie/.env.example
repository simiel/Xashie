# Client-safe Expo values only. EXPO_PUBLIC_* values are bundled into the app.
EXPO_PUBLIC_HASHIE_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_clerk_publishable_key

# Google OAuth is configured in the Clerk Dashboard. These client IDs are public
# identifiers used by the native Clerk flow and are copied into Expo app config.
EXPO_PUBLIC_CLERK_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID=
# Must be the reversed iOS client ID: com.googleusercontent.apps.<client-id-prefix>
EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME=
# Never add the Google Web client secret to this file or mobile app config.
# Never add CLERK_SECRET_KEY, CLERK_JWT_KEY, SUPABASE_SERVICE_ROLE_KEY,
# database credentials, or other server secrets to the mobile environment.
