# Copy these client-safe values into the EAS project's production environment.
# Do not commit a populated production .env file and never add server secrets here.
EXPO_PUBLIC_HASHIE_API_BASE_URL=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_ANDROID_CLIENT_ID=
# Use the reversed iOS client ID: com.googleusercontent.apps.<client-id-prefix>
EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME=
